# EditorConfig — baseline whitespace consistency across all editors/IDEs.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,jsx,ts,tsx,mjs,json,css,md,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

# Markdown: trailing spaces can be meaningful (hard line breaks)
[*.md]
trim_trailing_whitespace = false
