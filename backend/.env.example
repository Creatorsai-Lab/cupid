# Copy to .env and fill in. Every setting in app/config.py is listed here
# (tests/core/test_config.py keeps the two in sync); unknown keys stop the app.

# ── App ──────────────────────────────────────────────────
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=true
SESSION_TTL_SECONDS=604800
# Fernet key for stored OAuth tokens. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Infrastructure (docker-compose.yml) ──────────────────
DATABASE_URL=postgresql+asyncpg://cupid:cupid@localhost:5433/cupid_db
REDIS_URL=redis://localhost:6380/0
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (login + YouTube connect share one client) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add both URIs to the Google OAuth client's Authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/youtube/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── APITxT SMS OTP (phone login; blank authkey = disabled) ──
APITXT_AUTHKEY=
APITXT_BASE_URL=https://apitxt.com
# Dashboard SMS template id (DLT-approved, contains {otp}); blank = account default
APITXT_SMS_TEMPLATE_ID=

# ── External APIs (blank = not configured) ───────────────
GROQ_API_KEY=
TAVILY_API_KEY=
GNEWS_API_KEY=
# Old composer fallback; removed with it in Phase 5.
HUGGINGFACE_API_KEY=

# ── Admin ────────────────────────────────────────────────
# Comma-separated emails auto-promoted to admin at startup
ADMIN_EMAILS=
# SQLAdmin dashboard (leave user/password blank to NOT mount the panel)
ADMIN_PANEL_PATH=/ctrl-panel
ADMIN_PANEL_USER=
ADMIN_PANEL_PASSWORD=
# Signs the dashboard session cookie (falls back to SECRET_KEY if blank)
ADMIN_SESSION_SECRET=
